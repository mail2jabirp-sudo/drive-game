{
  "name": "kottakkal-drive-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "map:import": "python3 scripts/import_osm.py",
    "map:check": "python3 scripts/check_map.py && python3 scripts/check_export.py",
    "prebuild": "npm run map:check",
    "predev": "npm run map:check",
    "test:production": "playwright test --config playwright.production.config.ts",
    "map:export": "python3 scripts/import_export_roads.py",
    "map:terrain": "python3 scripts/prepare_elevation.py"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/three": "^0.180.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
